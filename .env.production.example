# Copy to .env.production on the machine that runs production. Never commit the filled file.
# Real client records — BastionGPT (BAA) runtime only. Values below are placeholders.
APP_PROFILE=production

# BastionGPT adapter (first non-empty wins)
BASTIONGPT_API_KEY=

# Langfuse — HIPAA project keys ONLY (never the demo project's)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# No OPENAI_API_KEY — production never calls OpenAI.
