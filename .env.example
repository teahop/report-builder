# Copy to .env and fill in. Never commit .env.
# Synthetic / de-identified fixtures only — not for real client records.

# Read by main.py (via python-dotenv) and the OpenAI client in provider.py.
OPENAI_API_KEY=

# Langfuse tracing (optional — degrades to no-op when unset).
# provider.py wraps OpenAI with langfuse.openai; either host name works.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

# BastionGPT adapter in provider.py (backend="bastion"). First non-empty wins.
BASTIONGPT_API_KEY=
BASTION_API_KEY=
BASTIONGPT_KEY=
